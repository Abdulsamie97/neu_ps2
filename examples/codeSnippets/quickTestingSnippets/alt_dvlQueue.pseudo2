struct dvlElem 
	num key
	dvlElem next
	dvlElem prev

struct ptr
	dvlElem ptr
 
var head = new ptr
var tail = new ptr

func enqueue(k)
	print "Enqueue: " + k
	var p = new dvlElem
	p.key = k
	p.next = null
	p.prev = null
	if empty()
		print "[ENQ] Inserting first element ..."
		head.ptr = p
		tail.ptr = p
	else
	    p.prev = tail.ptr
	    tail.ptr.next = p
	    tail.ptr = p
	print "[ENQ] Head key is now: " + head.ptr.key 
	print "[ENQ] Tail key is now: " + tail.ptr.key 

 
func dequeue()
	print "Dequeue ..."
	if empty()
		throw "ERROR: dequeue() invoked on empty list"
	
	print "[DEQ] Saving head element"
	var k = head.ptr.key
	print "[DEQ] Setting head"
	head.ptr = head.ptr.next
	print "[DEQ] Check if head is now null"
	if (head.ptr == null)
		print "[DEQ] Queue is now empty"
		tail.ptr = null
	
	print "[DEQ] Return key..." 
	return k


func empty()
	return head.ptr == null || tail.ptr == null


//  usage
print "Is queue empty?: " + empty()
enqueue(1)
enqueue(2)
enqueue(3)
enqueue(4)
print "Is queue empty?: " + empty()
if (empty() != false)
	throw "Error 1"

print "Everything enqueued"
var a = dequeue() // 1
print a
var b = dequeue()
print b
var c = dequeue()
print c
var d = dequeue()
print d

if (a != 1 || b != 2 || c != 3 || d != 4)
	throw "Error 2"

print empty()

if (empty() != true)
	throw "Error 3"