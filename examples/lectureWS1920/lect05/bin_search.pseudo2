//// ganzzahlige Division
func div(a, b) 
	return (a - (a mod b)) / b


func bin_search( A[1..n], key )
	var a = 1			// suche von A[a] (linke Grenze)
	var b = n			// â€¦ bis A[b] (rechte Grenze)
	while  a <= b		
		var m = div((a+b),2)		// die Mitte, abgerundet
		if A[m] == key
			// gefunden (am Index m)
			return 1	
		if A[m] > key
			// suche in links weiter
			b = m-1		
		else
			// suche in rechts weiter
			a = m+1		

	// fertig, nichts gefunden		
	return 0			

var B[4] = 3
B[1] = 1
B[2] = 16
B[3] = 25
B[4] = 36
 

var l = bin_search(B, 25)

print l

