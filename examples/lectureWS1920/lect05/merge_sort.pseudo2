//// ganzzahlige Division
func div(a, b) 
    return (a - (a mod b)) / b

func merge_sort( A[1..n]) 
    if n > 1
        var lsize = div(n, 2)   
        var rsize = n-lsize
        var L[lsize] = 0
        var R[rsize] = 0
        for i = 1 to n
            if (i <= lsize)
                L[i] = A[i]
            else
                R[i-lsize] = A[i]
        merge_sort(L)
        merge_sort(R)
        var il = 1
        for j = 1 to n
            if il > lsize
                A[j] = R[j-lsize]
            else
                if il == j-rsize
                    A[j]=L[il]
                    il = il +1
                else
                    if L[il] <= R[j-il+1]
                        A[j] = L[il]
                        il = il + 1
                    else 
                        A[j] = R[j-il+1]
    

