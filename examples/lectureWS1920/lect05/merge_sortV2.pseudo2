//// ganzzahlige Division
func div(a, b) 
    return (a - (a mod b)) / b

func merge(L[1..lsize], R[1..rsize], A[1..n])
    var il = 1
    for j = 1 to n
        if il > lsize
            // L bereits leer
            A[j] = R[j-lsize]
        else
            if il == j-rsize
                // R bereits leer
                A[j]=L[il]
                il = il +1
            else
                if L[il] <= R[j-il+1]
                    A[j] = L[il]
                    il = il + 1
                else 
                    A[j] = R[j-il+1]


func merge_sort( A[1..n])
    if n > 1
        // split A into L and R
        var lsize = div(n, 2)   
        var rsize = n-lsize
        var L[lsize] = 0
        var R[rsize] = 0
        for i = 1 to n
            if (i <= lsize)
                L[i] = A[i]
            else
                R[i-lsize] = A[i]
                
        // sort L and R        
        merge_sort(L)
        merge_sort(R)
        
        merge(L, R, A)
    

var B[4] = 3
B[1] = 96
B[2] = 86
B[3] = 75
B[4] = 36
 

merge_sort(B)

