// Queue Implementierung mit Array (1. Variante)


var Q[10] = 0  // hinreichend grosses Array
var tail = 1   // Hilfsvariable

func empty()
    if tail == 1
        return 1
    else
        return 0
        
func enqueue(x)
    Q[tail] = x
    tail = tail + 1
    print "deb: tail is " + tail 
    
func dequeue()
    if empty()==1
        throw "Unexpected Situation"  

    var x = Q[1]
    tail = tail - 1
    for i=2 to tail
        Q[i-1] = Q[i]

    return x    
    
print empty()
enqueue(3)
enqueue(4)
enqueue(5)
print dequeue()
print dequeue()
enqueue(27)
print empty()
print "tail is " + tail
