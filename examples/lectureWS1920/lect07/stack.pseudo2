// Stack Implementierung als Array

var n = 10
var S[n] = 0  // hinreichend grosses Array
var top = 1   // Index hinter dem neuesten Element


func empty()
    if top==1
        return 1
    else
        return 0

func push(x)
    S[top] = x
    top = top + 1

func pop()
    if empty()==1
        throw "pop() cannot be invoked on empty stack"
    top = top - 1
    var x = S[top]
    return x


print empty()
push(4)
push(22)
push(8)
print  pop()   // prints 8
print  empty()
print  pop()   // prints 22
print  pop()   // prints 4
print  pop()   // causes exception

