

struct evlElem 
	num key
	evlElem next


var e4 = new evlElem
e4.key=4
e4.next=null

var e1 = new evlElem
e1.key=1
e1.next=e4

var e3 = new evlElem
e3.key=3
e3.next=e1

var e9 = new evlElem
e9.key=9
e9.next=e3

var e8 = new evlElem
e8.key=8
e8.next=e9

var e5 = new evlElem
e5.key=5
e5.next=e8

var L = e5  // set to first element



//
// go through list
//	
var p = L
while (p != null)
	print p.key
	p = p.next



print L.next.key   // access to 2nd element
print L.next.next.key  // access to 3rd element


//
// find maximum element of list
//
p = L
var max = p.key
while p != null 
	if p.key > max
		max = p.key
	p = p.next

print "Maximal element has value " + max




