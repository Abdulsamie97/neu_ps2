struct treeElem
	num key
	treeElem left
	treeElem right
	
var root = new treeElem

 
func isearch(node, key)
	while node!=null && key!= node.key
		if key < node.key
			node=node.left
		else
			node=node.right
	return node
			
// we need function call to resolve types of parameters				
isearch(root, 4)	
	
	