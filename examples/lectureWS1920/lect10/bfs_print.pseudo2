//
// Prints the vid of each reachable node of Graph V
// using breadth-first-search (bfs)
//
// Construction of graph is done in function init()


// general debug-flag for printing out DEBUG-messages
var debug=false


struct edgeElem
    num vid // vertex id
    edgeElem next 
    
var dummy = new edgeElem    


// initialization and printing
var V[6] = dummy
init(V)  // creates graph

var s_white = 0  // status white (new)
var s_grey = 1 // status grey (discovered)
var s_black = 2 // status black (processed)

var VStatus[6] = s_white // initially set to new

// initializing queue (FIFO)
var tail = 1   // Index für neues Element
var Q[100] = 0  // ArrayQueue

// invoking breath-first-search
bfs(1) 

// print out each reachable node exactly once
func bfs(start)
    printDebug ("bfs started")
    VStatus[start]=s_grey
    enqueue(start)
    
    while !empty()
        var v = dequeue()
        if VStatus[v]!=s_black
            var p = new edgeElem
            p = V[v]
            registerNeighbors(p)
            print  v 
            VStatus[v]=s_black
    
    printDebug ("bfs finished")
    
    
func registerNeighbors(first)
    printDebug ("registerNeighbors entered")
    if first == null
        return

    printDebug ("registerNeighbors: processing node " + first.vid)
    if VStatus[first.vid]==s_white
        VStatus[first.vid] = s_grey
        printDebug ("registerNeighbors: node " + first.vid + " set to grey")
        enqueue(first.vid)
    
    registerNeighbors(first.next)    


//
// Implementation Queue
//



func empty()
    if tail == 1
        return true
    else
        return false
        
func enqueue(x)
    Q[tail] = x
    tail = tail + 1
    
func dequeue()
    if empty()
        throw "dequeue() requires non-empty queue"  

    var x = Q[1]
    tail = tail - 1
    for i=2 to tail
        Q[i-1] = Q[i]

    return x    



//
// Functions
//

func printDebug(msg)
    if (debug)
        print "DEBUG " + msg




func printGraph(A[1..n])
    var p = new edgeElem
    for i=1 to n
        p = A[i]
        print "Adacency list for node " + i + " is: " + edgeListToString(p)  //OK


// example given in lecture
func init(A[1..n])
    A[1]=toEdgeList([2,3,6])
    A[2]=toEdgeList([1,3,4])
    A[3]=toEdgeList([1,2,4,5,6])
    A[4]=toEdgeList([2,3,5])
    A[5]=toEdgeList([3,4,6])
    A[6]=toEdgeList([1,3,5])

/*
// example of binary tree 
func init(A[1..n])
    A[1]=toEdgeList([2,3])
    A[2]=toEdgeList([1,4,5])
    A[3]=toEdgeList([1,6])
    A[4]=toEdgeList([2])
    A[5]=toEdgeList([2])
    A[6]=toEdgeList([3])
*/

func edgeListToString(first)
    if first==null
        return "null"
    var tailAsString = edgeListToString(first.next)    
    return first.vid + " " + tailAsString   
    

func toEdgeList(A[1..n])
    if n==0
        return null
    var start=new edgeElem
    start.vid = A[1]
    start.next=null
    var last = new edgeElem
    last = start
    for i=2 to n
        var e = new edgeElem
        e.vid=A[i]
        e.next=null
        last.next=e
        last=e
    return start    

  