//
// Prints the vid of each reachable node of Graph V
// using depth-first-search (bfs)
//
// Construction of graph is done in function init()


// general debug-flag for printing out DEBUG-messages
var debug=false


struct edgeElem
    num vid // vertex id
    edgeElem next
    
var dummy = new edgeElem    

 
// initialization and printing
var V[6] = dummy
init(V)  // creates graph

var s_white = 0  // status white (new)
var s_grey = 1 // status grey (discovered)
var s_black = 2 // status black (processed)

var VStatus[6] = s_white // initially set to new

// invoking depth-first-search
dfs(1) 

// print out each reachable node exactly once
func dfs(node)
    if VStatus[node]==s_white
        printDebug ("dfs started")
        VStatus[node]=s_grey
        print(node)
        var p = new edgeElem
        p = V[node]
        while p!=null
            dfs(p.vid)
            p=p.next
        VStatus[node]=s_black
    
    printDebug ("dfs finished")
    




//
// Functions
//

func printDebug(msg)
    if (debug)
        print "DEBUG " + msg




func printGraph(A[1..n])
    var p = new edgeElem
    for i=1 to n
        p = A[i]
        print "Adacency list for node " + i + " is: " + edgeListToString(p)  //OK


