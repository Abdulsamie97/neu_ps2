    A[2]=toEdgeList([1,4,5])
    A[3]=toEdgeList([1,6])
    A[4]=toEdgeList([2])
    A[5]=toEdgeList([2])
    A[6]=toEdgeList([3])
//*/

func edgeListToString(first)
    if first==null
        return "null"
    var tailAsString = edgeListToString(first.next)    
    return first.vid + " " + tailAsString   
    

func toEdgeList(A[1..n])
    if n==0
        return null
    var start=new edgeElem
    start.vid = A[1]
    start.next=null
    var last = new edgeElem
    last = start
    for i=2 to n
        var e = new edgeElem
        e.vid=A[i]
        e.next=null
        last.next=e
        last=e
    return start    

  