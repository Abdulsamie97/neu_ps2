func edgeListToString(first)
    if first==null
        return "null"
    var tailAsString = edgeListToString(first.next)    
    return first.vid + " " + tailAsString   
    

func toWeightedEdgeList(A[1..n], W[1..m])
    if n==0 || m==0
        return null
    var start=new edgeElem
    start.vid = A[1]
    start.weight = W[1]
    start.next=null
    var last = new edgeElem
    last = start
    for i=2 to n
        var e = new edgeElem
        e.vid=A[i]
        e.weight=W[i]
        e.next=null
        last.next=e
        last=e
    return start    

			