//
// Dijkstra-Algorithm for computing the shortest path
//
// Construction of graph is done in function init()


// general debug-flag for printing out DEBUG-messages
//var debug=false
var debug=true


struct edgeElem
    num vid // vertex id
    num weight 
    edgeElem next
    
var dummy = new edgeElem    
 

// initialization 
var noNodes = 6  // how many nodes do we have?
var V[noNodes] = dummy
init(V)  // creates graph

// labeling the nodes
var Label[noNodes]=""

var AllChars = ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "L", "M", "N", "O", "P", "Q", "R", "S", "T", "U", "V", "W", "X", "Y", "Z"]


for i=1 to noNodes
    Label[i]=AllChars[i]

var nA = 1
//var nB = 2
var nC = 3
var nD = 4
var nE = 5
var nF = 6


var s_white = 0  // status white (new)
var s_grey = 1 // status grey (discovered)
var s_black = 2 // status black (processed)


var start=nA  // which is the start node


var pred[noNodes]=0
for i=1 to noNodes
    pred[i]=i
    
var dist[noNodes]=-1
dist[start]=0

var mark[noNodes]=s_white

// Initializing Datastructure X

var X[10]=0
var tail=1

// invoking shortest Path

dijkstra(nF) 


func dijkstra(target)
    add(start)
    
    while !empty()
        var x = 0
        x = getElementWithMinDist()
        mark[x]=s_black
        delete(x)
        printDebug("L1 empty()="+empty())
        if x==target
            var len = dist[x]
            print "Have found a path from " + Label[start] + " to " + Label[target] + " with length " + len
            return
            
        var p = new edgeElem
        p = V[x]
        while p!=null
            var y = p.vid
            var d = dist[x] + p.weight
            if dist[y] == -1 || d < dist[y]
                dist[y]=d
                printDebug("set dist[" + y + "]=" + d)
                pred[y]=x
            if mark[y]==s_white
                mark[y]=s_grey
                add(y)
            p=p.next    

    printDebug("dijkstra() finished")
    
    
    
    

//
// Datastructure X
//

func empty()
    return tail==1

func add(x)
	if contains(x)
		print ("WARNING: cannot insert " + x + " another time")
	X[tail] = x
	tail = tail +1
	
func delete(x)
	if !contains(x)
		print("WARNING: Could not found " + x + " to delete")
	
	for i=1 to tail-1
		if X[i]==x
			for j=i to tail-2
				X[j]=X[j+1]
			tail=tail-1

func contains(x)
	for i=1 to tail-1
		if x==X[i]
			return true
	return false
	
// assumption: dist[n] >= 0 for all n from X	
func getElementWithMinDist()
	if empty()
		throw "getElementMinDist() invoked on empty X"
	var n = X[1]
	var min=dist[n]
	for i=2 to tail-1
		n=X[i]
		if dist[n] < min
			min = dist[n]
			
	for j=1 to tail-1
		n=X[j]
		if dist[n]==min
			return n
			
	throw "getElementWithMinDist(): Could not found index with minimal distance"
	







//
// Functions
//

func printDebug(msg)
    if (debug)
        print "DEBUG " + msg

func printGraph(A[1..n])
    var p = new edgeElem
    for i=1 to n
        p = A[i]
        print "Adacency list for node " + i + " is: " + edgeListToString(p)  //OK

