//
// Computation and printing of Fibonacci-numbers up to a certain limit
// 

//################################################
//#
//#   Main
//#
//################################################

printFibonacciUntil(1000)		

print "finished"


//################################################
//#
//#   Definitions (Functions/Structs)
//#
//################################################
 

func printFibonacciUntil(limit)
	var a = 0
	var b = 1
	var b1 = 0 
	var res = ""
	while a < limit
		res = res + a + " "
		b1 = b // save old value of b
		b = a + b
		a = b1
	print res
	
