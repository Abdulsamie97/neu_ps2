//
// Illustrates basic data structures and types
//  - STRUCTS (user-defined)
//
// Note that structs can - in addition to attributes -
// also carry methods. Thus, a struct can be used to easily
// implement an Abstract Data Type (ADT). This is illustrated 
// in a separate file.
              
  

//################################################
//#
//#   Main
//#
//################################################


struct Person   // this introduces new datatype Person  
           // (unfortunately, we have to keep the next line blank due to this comment :-(   )
                  
	string name   // component 'name' of type string
	num age       // component 'age' of type num (numeric - stands for integer and reals)
	Person mother  // component 'mother' of type Person
	num[] ids    // component 'ids' of type ArrayOf(num)


		
var p1 = new Person   // instantiating struct Person
p1.name = "Anna"   // write access to component
p1.age = 28
p1.mother = null
p1.ids = [1,2,3]
//p1.familyName = "Brown"  ////SYNTAX ERROR: Access to unknown component 'familyName'

for i=1 to 3
	print p1.ids[i]  

var p2 = new Person   // instantiating struct Person
p2.name = "Jon"   // write access to component
p2.age = 2
p2.mother = p1
p2.ids = [4,5]


//print p1.mother.age  	// THROWS NullPointerException (NPE) 
						// since p1.mother==null

if p1.mother!=null
	print p1.mother.age  // does nothing but works without runtime error

print p2.mother.age // print 28

var arrPerson[3] = p1  // initialize each cell with THE VERY SAME INSTANCE referenced by p1

for i=1 to 3
	print arrPerson[i].age 
	
p1.age=30  	// changing the age of p1 will 
  			// change it for all array members
for i=1 to 3
	print arrPerson[i].age  // all elements in the array 
	                        // have now the same new age


var arrDiffPerson[3] = new Person  // initialize each array-cell with a DIFFERENT person

p1 = arrDiffPerson[2]
p1.age = 25   // set the age value for the second array cell

for i=1 to 3
    print arrDiffPerson[i].age // only the second person has a value


print "finished"
