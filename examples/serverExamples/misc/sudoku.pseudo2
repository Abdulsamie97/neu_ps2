//################################################
//#
//#   Definitions (Functions/Structs)
//#
//################################################



// simulation of 2-dimensional array
// Note that Board does not have any dependency 
struct Board 
	num rowLength
	num[] c  // content 
	g(row, col) 
		return this.c[this.rowLength*(row-1)+col]
		
	s(row, col, val)	
		this.c[this.rowLength*(row-1)+col] = val


// printing out a Board
func printB(b)
	var output = "\\n"
	var h = ""
	var lineSep="+----------------------+"
	for r=1 to b.rowLength
		if (r-1) mod N == 0
			output = output + lineSep + "\\n"
			
		var row = ""
		for c=1 to b.rowLength
			if (c-1) mod N == 0
				row = row+"|  "
			h = b.g(r,c)+""	
			if 	h == "0"
				h = "."
			row=row + h + "  "
		output = output +  row + "|" + "\\n"
	output = output +   lineSep
	print output

		

// check for conflict in row/column/sub-square				
func conflictOne(b, r0, c0, h, w)
	var histogram[NN]=0
	for rr = r0 to r0 + h
		for cc=c0 to c0+w
			var x = b.g(rr,cc) 
			if x>0
				if histogram[x] > 0
					return true
				histogram[x]=1

	return false 



func conflictAny(b)
	// check each row
	for r=1 to NN
		if conflictOne(b, r, 1, 0, NN-1)
			return true

	// check each column
	for c=1 to NN
		if conflictOne(b, 1, c, NN-1, 0)
			return true

	// check each sub-square
	for r=1 to NN-1 by N
		for c=1 to NN-1 by N
			if conflictOne(b, r, c, N-1, N-1)
				return true
				
	return false
	

func solve(b, r, c)			
	count = count +1
	if r == NN+1
		return true  // entire sudoku filled
		
	var rr = r
	var cc = c + 1
	if cc>NN
		cc=1
		rr = r+1
		
	if b.g(r,c)!=0
		return solve(b, rr, cc)
	else
		for x=1 to NN
			call b.s(r,c,x) // try x
			if !conflictAny(b)
				if solve(b, rr, cc)
					return true
		
		// for no x we found a solution; backtracking
		call b.s(r,c,0)
		return false	
		

