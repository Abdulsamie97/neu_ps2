//         ###    ########  ########  ##       ####  ######     ###    ######## ####  #######  ##    ## 
//        ## ##   ##     ## ##     ## ##        ##  ##    ##   ## ##      ##     ##  ##     ## ###   ## 
//       ##   ##  ##     ## ##     ## ##        ##  ##        ##   ##     ##     ##  ##     ## ####  ## 
//      ##     ## ########  ########  ##        ##  ##       ##     ##    ##     ##  ##     ## ## ## ## 
//      ######### ##        ##        ##        ##  ##       #########    ##     ##  ##     ## ##  #### 
//      ##     ## ##        ##        ##        ##  ##    ## ##     ##    ##     ##  ##     ## ##   ### 
//      ##     ## ##        ##        ######## ####  ######  ##     ##    ##    ####  #######  ##    ## 
//

func processExample()
	var s = new Stack
	call s.init()
	
	addOpenTag("html", s)
	addOpenTag("head", s)
	addOpenTag("title", s)
	addContent("Mein Lieblingsfach", s)
	addCloseTag("title", s)
	addCloseTag("html", s) // generates a warning
    



func addOpenTag(tag, s)
	call s.push(tag)
    
func addCloseTag(tag, s)
	var expected = s.pop()
	if tag!=expected
		var msg = "Expected closing tag '" + expected + "' but was '" + tag + "'"
		print "WARNING: Unbalanced document. " + msg

func addContent(text, s)
	// do nothing
    


