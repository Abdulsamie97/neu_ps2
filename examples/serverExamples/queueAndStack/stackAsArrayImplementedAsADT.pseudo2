//
//  STACK IMPLEMENTED BASED ON AN ARRAY IN FORM OF AN ADT
//
// Note that one limitation here is, that the stack has a
// fixed, maximal length.
//
//
// A bit advantage compared to the implemenation without ADT
// is that multiple stacks can be used at the same time





//################################################
//#
//#   Main
//#
//################################################

var len = 10

struct Stack
	num[] S
	num top
	
	init()
		// this.S[len]=0  // this does NOT initializes S as array of length len
		                  // since it is read as assignment to cell S[len]
		// workaroung to initialize this.S
		var help[len] = 0
		this.S = help
		                  
		this.top=1

	isEmpty()
    	if this.top == 1
        	return true
    	else
        	return false

	isFull()
		if this.top > len
			return true
		return false
  
	/*
	 * Pushing a new element on the stack.
	 * 
	 * NOTE: It is the responsibility of the caller
	 * to check before, that the stack is not full yet.
	 * 
	 * If the stack is full, an exception is thrown and
	 * the program execution stops.
	 * 
	 */       
	push(x)
		if this.isFull()
			throw "ERROR: stack is already full"
		this.S[this.top] = x
		this.top = this.top + 1



	/*
	 * Returning the youngest element from the stack.
	 * (note that stack is a LIFO (last-in first-out) memory)
	 * 
	 * NOTE: It is the responsibility of the caller
	 * to check before, that the stack is not empty yet.
	 * 
	 * If the stack is empty, an exception is thrown and
	 * the program execution stops.
	 * 
	 */       
	pop()
	    if this.isEmpty()
	        throw "ERROR: stack is empty"  
	    this.top = this.top - 1
	    return this.S[this.top]


var s1 = new Stack
call s1.init()
var s2 = new Stack
call s2.init()
 
// now we can use s1 and s2 in parallel 
 
print s1.isEmpty() // true
call s1.push(4)
call s1.push(22)

call s2.push(3)
call s2.push(21)

call s1.push(8)

print  s1.pop()   // prints 8
print  s2.pop()   // prints 21
print  s2.pop()   // prints 3
print  s2.isEmpty()	 // true
print  s1.pop()   // prints 22
print  s1.pop()   // prints 4

//print  s2.pop()   // causes exception


print "finished"
