//
//  INSERTION SORT
//

//################################################
//#
//#   Main
//#
//################################################


var B = [4, 6, 2, 5]


insertionSort(B)

for i=1 to 4
	print B[i]


print "finished"



//################################################
//#
//#   Definitions (Functions/Structs)
//#
//################################################


func insertionSort( A[1..n] )
	for i = 2 to n
		inserti( A, i )


// inserts element A[i] at the right
// place left from it
// Note: the elements left from A[i] are already sorted
func inserti( A[1..n], i )
	var x = A[i]
	var j = i-1
	while j>=1 && A[j]>x
		A[j+1] = A[j]
		j = j-1
	A[j+1] = x



