//
//  MERGE SORT
//


//################################################
//#
//#   Main
//#
//################################################

var B = [4, 6, 2, 5]


mergeSort(B)

for i=1 to 4
	print B[i]


print "finished"


//################################################
//#
//#   Definitions (Functions/Structs)
//#
//################################################

  
func mergeSort( A[1..n]) 
    if n > 1
        var lsize = div(n, 2)   
        var rsize = n-lsize
        var L[lsize] = 0
        var R[rsize] = 0
        for i = 1 to n
            if (i <= lsize)
                L[i] = A[i]
            else
                R[i-lsize] = A[i]
        mergeSort(L)
        mergeSort(R)
        var il = 1
        for j = 1 to n
            if il > lsize
                A[j] = R[j-lsize]
            else
                if il == j-rsize
                    A[j]=L[il]
                    il = il +1
                else
                    if L[il] <= R[j-il+1]
                        A[j] = L[il]
                        il = il + 1
                    else 
                        A[j] = R[j-il+1]
    


//// integer division, i.e. result is an integer  (div(13,3)=4)
func div(a, b) 
    return (a - (a mod b)) / b



