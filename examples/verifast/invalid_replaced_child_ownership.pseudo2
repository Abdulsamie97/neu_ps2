struct Buffer
  num[] values

@requires true
@ensures vf_struct(result) && vf_array(vf_field(result, "values")) && vf_int(vf_elem(vf_field(result, "values"), 1)) == 1
func replaceArrayField()
  var buffer = new Buffer
  var first[1] = 1
  var second[1] = 2
  buffer.values = first
  buffer.values = second
  return buffer

