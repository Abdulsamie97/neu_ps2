@requires length(matrix) == 2 && length(matrix[1]) == 2 && matrix[1][2] == 2
@ensures result == 2
func readNestedDirect(matrix[1..rows])
  return matrix[1][2]

func directNestedArrays()
  var matrix = [[1, 2], [3, 4]]
  @assert matrix[2][1] == 3
  return readNestedDirect(matrix)

print directNestedArrays()
