@requires true
@ensures result == 5
func add()
  return 2 + 3

@requires true
@ensures result == 5
func subtract()
  return 8 - 3

@requires true
@ensures result == 12
func multiply()
  return 3 * 4

@requires true
@ensures result == 4
func divide()
  return 8 / 2

@requires true
@ensures result == 2
func modulo()
  return 8 mod 3

@requires true
@ensures result == 8
func power()
  return 2 ^ 3

@requires a >= INT_MIN && b >= INT_MIN
@ensures result == a + b
func addParameters(a, b)
  return a + b
