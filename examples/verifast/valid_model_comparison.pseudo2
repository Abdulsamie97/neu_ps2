@requires true
@ensures result == true
func less()
  return 2 < 3

@requires true
@ensures result == true
func lessEqual()
  return 3 <= 3

@requires true
@ensures result == true
func greater()
  return 4 > 3

@requires true
@ensures result == true
func greaterEqual()
  return 4 >= 4

@requires true
@ensures result == false
func falseComparison()
  return 4 < 3

@requires a >= INT_MIN && b >= INT_MIN
@ensures (result == true) == (a < b)
func compareParameters(a, b)
  return a < b
