@requires true
@ensures result == true
func equalNumbers()
  return 7 == 7

@requires true
@ensures result == false
func unequalNumbers()
  return 7 != 7

@requires true
@ensures result == true
func equalStrings()
  return "same" == "same"

@requires true
@ensures result == false
func unequalStrings()
  return "left" == "right"

@requires true
@ensures result == true
func equalNull()
  return null == null

@requires a >= INT_MIN && b >= INT_MIN
@ensures (result == true) == (a == b)
func equalParameters(a, b)
  return a == b
