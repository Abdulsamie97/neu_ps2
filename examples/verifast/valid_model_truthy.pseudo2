@requires true
@ensures result == true
func andTrue()
  return true && true

@requires true
@ensures result == false
func andFalse()
  return true && false

@requires true
@ensures result == true
func orTrue()
  return false || true

@requires true
@ensures result == false
func notTrue()
  return !true

@requires x >= INT_MIN
@ensures (result == true) == !!x
func normalizeTruthiness(x)
  return !(!x)
