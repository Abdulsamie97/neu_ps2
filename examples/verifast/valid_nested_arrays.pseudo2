@requires length(matrix) == 2 && length(matrix[1]) == 2 && matrix[1][2] == 2
@ensures result == 2
func readNested(matrix[1..rows])
  return matrix[1][2]

func nestedArrays()
  var matrix = [[1, 2], [3, 4]]
  @assert matrix[2][1] == 3
  matrix[2][1] = 9
  @assert matrix[2][1] == 9
  return readNested(matrix)

print nestedArrays()
