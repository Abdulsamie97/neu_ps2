@requires vf_array(matrix) && vf_len(matrix) == 2 && vf_array(vf_elem(matrix, 1)) && vf_len(vf_elem(matrix, 1)) == 2 && vf_int(vf_elem(vf_elem(matrix, 1), 2)) == 2
@ensures vf_int(result) == 2
func readNested(matrix[1..rows])
  return matrix[1][2]

func nestedArrays()
  var matrix = [[1, 2], [3, 4]]
  @assert vf_int(vf_elem(vf_elem(matrix, 2), 1)) == 3
  matrix[2][1] = 9
  @assert vf_int(vf_elem(vf_elem(matrix, 2), 1)) == 9
  return readNested(matrix)

print nestedArrays()
