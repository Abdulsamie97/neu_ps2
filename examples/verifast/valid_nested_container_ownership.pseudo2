struct Buffer
  num[] values

@requires true
@ensures length(result.values) == 2 && result.values[2] == 7
func makeBuffer()
  var buffer = new Buffer
  var values[2] = 0
  values[2] = 7
  buffer.values = values
  return buffer

@requires length(buffer.values) == 2 && (1 <= 2 && 2 <= length(buffer.values)) && buffer.values[2] == 7
@ensures length(buffer.values) == 2 && buffer.values[2] == 7 && result == 7
func readBuffer(buffer)
  return buffer.values[2]

@requires length(buffer.values) == 2 && (1 <= 2 && 2 <= length(buffer.values)) && buffer.values[2] == 7
@ensures length(result.values) == 2 && result.values[2] == 8
func updateBuffer(buffer)
  buffer.values[2] = 8
  return buffer

@requires true
@ensures result.values[2] == 8
func roundTripBuffer()
  var buffer = makeBuffer()
  var value = readBuffer(buffer)
  @assert value == 7
  buffer = updateBuffer(buffer)
  return buffer

struct Cell
  num value

@requires true
@ensures length(result) == 1 && result[1].value == 9
func makeCellArray()
  var cell = new Cell
  cell.value = 9
  var cells[1] = cell
  return cells

@requires length(cells) == 1 && 1 <= length(cells) && cells[1].value == 9
@ensures length(cells) == 1 && cells[1].value == 9 && result == 9
func readCellArray(cells[1..n])
  var cell = cells[1]
  return cell.value

@requires true
@ensures length(result) == 1 && result[1].value == 9
func roundTripCellArray()
  var cells = makeCellArray()
  var value = readCellArray(cells)
  @assert value == 9
  return cells
