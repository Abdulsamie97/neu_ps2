@requires A == B && 1 <= length(A)
@ensures result == 7 && A[1] == 7 && B[1] == 7
func writeArrayAlias(A[1..n], B[1..m])
  B[1] = 7
  return A[1]

@requires true
@ensures result == 7
func callArrayAlias()
  var A[1] = 0
  return writeArrayAlias(A, A)

struct Box
  num value

@requires left == right && left.value == undefined && right.value == undefined
@ensures result == 9 && left.value == 9 && right.value == 9
func writeStructAlias(left, right)
  right.value = 9
  return left.value

@requires true
@ensures result == 9
func callStructAlias()
  var box = new Box
  return writeStructAlias(box, box)
