struct Buffer
  num[] values

@requires true
@ensures length(result.values) == 1 && result.values[1] == 2
func replaceArrayField()
  var buffer = new Buffer
  var first[1] = 1
  var second[1] = 2
  buffer.values = first
  buffer.values = second
  return buffer

@requires true
@ensures length(result.values) == 1
func replaceArrayFieldInLoop()
  var buffer = new Buffer
  var first[1] = 1
  buffer.values = first
  var i = 0
  @invariant length(buffer.values) == 1 && i >= 0 && i <= 1
  while i < 1
    var second[1] = 2
    buffer.values = second
    i = i + 1
  return buffer

struct Cell
  num value

@requires true
@ensures length(result) == 1 && result[1].value == 2
func replaceStructElement()
  var first = new Cell
  first.value = 1
  var second = new Cell
  second.value = 2
  var cells[1] = first
  cells[1] = second
  return cells
