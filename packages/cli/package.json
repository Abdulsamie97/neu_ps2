{
    "name": "pseudo2-cli",
    "description": "The cli specific package",
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "bin",
        "out",
        "src"
    ],
    "bin": {
        "pseudo2-cli": "./bin/cli.js"
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "echo 'No build step'",
        "build:clean": "npm run clean && npm run build",
        "test": "npm run build --workspace pseudo2-language && vitest run"
    },
    "dependencies": {
        "pseudo2-language": "0.0.1",
        "chalk": "~6.0.1",
        "commander": "~15.1.0",
        "langium": "~4.4.0"
    },
    "devDependencies": {
        "vitest": "~5.1.0"
    },
    "volta": {
        "node": "22.23.5",
        "npm": "11.18.0"
    }
}
