{
    "name": "vscode-pseudo2",
    "description": "The extension specific package",
    "version": "0.0.1",
    "displayName": "pseudo2",
    "type": "module",
    "engines": {
        "vscode": "^1.107.0"
    },
    "categories": [
        "Programming Languages",
        "Debuggers"
    ],
    "contributes": {
        "configurationDefaults": {
            "[pseudo2]": {
                "editor.quickSuggestions": {
                    "other": true,
                    "comments": false,
                    "strings": false
                }
            }
        },
        "languages": [
            {
                "id": "pseudo2",
                "aliases": [
                    "Pseudo2",
                    "pseudo2"
                ],
                "extensions": [
                    ".pseudo2"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "pseudo2",
                "scopeName": "source.pseudo2",
                "path": "syntaxes/pseudo2.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "pseudo2.inspectVariables",
                "title": "Pseudo2: Ausfuehren und Variablen anzeigen",
                "icon": {
                    "light": "icons/run-light.svg",
                    "dark": "icons/run-dark.svg"
                }
            },
            {
                "command": "pseudo2.debug",
                "title": "Pseudo2: Debuggen",
                "icon": {
                    "light": "icons/debug-light.svg",
                    "dark": "icons/debug-dark.svg"
                }
            },
            {
                "command": "pseudo2.toggleLineComment",
                "title": "Pseudo2: Zeilenkommentar umschalten",
                "enablement": "editorLangId == pseudo2 && !editorReadonly"
            }
        ],
        "keybindings": [
            {
                "command": "pseudo2.toggleLineComment",
                "key": "ctrl+/",
                "mac": "cmd+/",
                "when": "editorTextFocus && editorLangId == pseudo2 && !editorReadonly"
            },
            {
                "command": "pseudo2.toggleLineComment",
                "key": "ctrl+shift+[Digit7]",
                "mac": "cmd+shift+[Digit7]",
                "when": "editorTextFocus && editorLangId == pseudo2 && !editorReadonly"
            }
        ],
        "breakpoints": [
            { "language": "pseudo2" }
        ],
        "debuggers": [
            {
                "type": "pseudo2",
                "label": "Pseudo2",
                "languages": ["pseudo2"],
                "configurationAttributes": {
                    "launch": {
                        "required": ["program"],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Pfad zur Pseudo2-Datei.",
                                "default": "${file}"
                            },
                            "timeoutMs": {
                                "type": "number",
                                "description": "Maximale Laufzeit pro Ausfuehrungsphase in Millisekunden.",
                                "default": 5000,
                                "minimum": 100
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "pseudo2",
                        "request": "launch",
                        "name": "Pseudo2 debuggen",
                        "program": "${file}"
                    }
                ]
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "pseudo2.variables",
                    "name": "Pseudo2-Variablen",
                    "when": "editorLangId == pseudo2"
                }
            ]
        },
        "menus": {
            "editor/title": [
                {
                    "command": "pseudo2.inspectVariables",
                    "when": "editorLangId == pseudo2",
                    "group": "navigation@1"
                },
                {
                    "command": "pseudo2.debug",
                    "when": "editorLangId == pseudo2",
                    "group": "navigation@2"
                }
            ],
            "view/title": [
                {
                    "command": "pseudo2.inspectVariables",
                    "when": "view == pseudo2.variables",
                    "group": "navigation"
                }
            ]
        }
    },
    "activationEvents": [
        "onLanguage:pseudo2",
        "onCommand:pseudo2.inspectVariables",
        "onCommand:pseudo2.debug",
        "onCommand:pseudo2.toggleLineComment",
        "onDebugResolve:pseudo2",
        "onView:pseudo2.variables"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "vscode:prepublish": "npm run build",
        "build:prepare": "npm run langium:generate --workspace pseudo2-language && shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/pseudo2.tmLanguage.json ./syntaxes/pseudo2.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "test": "node test/debugger.test.mjs && node test/highlighting.test.mjs",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\""
    },
    "dependencies": {
        "@vscode/debugadapter": "~1.68.0",
        "@vscode/debugprotocol": "~1.68.0",
        "langium": "~4.4.0",
        "pseudo2-language": "0.0.1",
        "vscode-languageclient": "~10.1.2",
        "vscode-languageserver": "~10.1.2"
    },
    "devDependencies": {
        "@types/vscode": "~1.107.0",
        "concurrently": "~10.0.7",
        "esbuild": "~0.28.2",
        "shx": "^0.4.0"
    },
    "vsce": {
        "dependencies": false
    }
}
