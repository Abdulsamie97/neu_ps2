{
    "name": "pseudo2-language",
    "description": "The language specific package",
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "out",
        "src"
    ],
    "main": "./out/index.js",
    "module": "./out/index.js",
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "default": "./out/index.js"
        },
        "./version": {
            "types": "./out/version.d.ts",
            "default": "./out/version.js"
        },
        "./browser/debug-value-view": {
            "types": "./out/browser/debug-value-view.d.ts",
            "default": "./out/browser/debug-value-view.js"
        },
        "./browser/debug-watch-panel": {
            "types": "./out/browser/debug-watch-panel.d.ts",
            "default": "./out/browser/debug-watch-panel.js"
        },
        "./browser/debug-breakpoint-dialog": {
            "types": "./out/browser/debug-breakpoint-dialog.d.ts",
            "default": "./out/browser/debug-breakpoint-dialog.js"
        },
        "./browser/debug-breakpoints": {
            "types": "./out/browser/debug-breakpoints.d.ts",
            "default": "./out/browser/debug-breakpoints.js"
        },
        "./browser/debug-shortcuts": {
            "types": "./out/browser/debug-shortcuts.d.ts",
            "default": "./out/browser/debug-shortcuts.js"
        },
        "./browser/editor-shortcuts": {
            "types": "./out/browser/editor-shortcuts.d.ts",
            "default": "./out/browser/editor-shortcuts.js"
        }
    },
    "typesVersions": {
        "*": {
            ".": [
                "out/index"
            ],
            "version": [
                "out/version"
            ]
        }
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "npm run langium:generate && tsc -p tsconfig.src.json",
        "build:clean": "npm run clean && npm run build",
        "langium:generate": "langium generate && node scripts/patch-textmate.mjs",
        "langium:watch": "langium generate --watch",
        "test": "npm run build && vitest run"
    },
    "dependencies": {
        "langium": "~4.4.0"
    },
    "devDependencies": {
        "langium-cli": "~4.4.0",
        "vitest": "~5.1.0"
    },
    "volta": {
        "node": "22.23.5",
        "npm": "11.18.0"
    }
}
