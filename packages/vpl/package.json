{
  "name": "pseudo2-vpl",
  "description": "Server-side JavaScript runner and evaluator for Pseudo2 in Moodle VPL",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=10.2.3"
  },
  "scripts": {
    "clean": "node clean.mjs",
    "build": "tsc -p tsconfig.json --noEmit && node esbuild.mjs",
    "test": "npm run build && node test/smoke.mjs"
  },
  "dependencies": {
    "langium": "~4.1.0",
    "pseudo2-language": "0.0.1"
  },
  "devDependencies": {
    "esbuild": "~0.25.5"
  }
}
